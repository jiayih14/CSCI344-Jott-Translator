    ::print[2.0 + 3.0];
    ::print[i > 7];
    ::print[i >= 7];
    ::print[i < 7];
    ::print[i <= 7];
    ::print[i == 7];
    ::print[i != 7];
    ::print[d > 1.0];
    ::print[b == b];
    ::print[True];
    ::print[False];
    ::print[b];
    ::print[s];
    ::print[::noparam[]];
    ::print[::onep[9]];
    ::print[::fourp[1, 1.0, "yes", True]];
    ::voidfn[3];
    ::print[::boolfn[20]];
    ::print[::dblfn[1.5]];
    ::print[::strfn["hi"]];
    ::print[::countdown[5]];
    ::print[::deep[5]];
    ::print[::recurse[4]];
    ::print[::length[s]];
    ::print[::length["abcdef"]];
    ::print[::concat[s, "def"]];
    ::print[::concat["x", ::concat["y", "z"]]];
    ::print[::length[::concat[s, "de"]]];
    ::print[::onep[::length[s]]];
    ::print[::onep[i] + 1];
    If[::boolfn[20]]{
        ::print["cond from function"];
    }
