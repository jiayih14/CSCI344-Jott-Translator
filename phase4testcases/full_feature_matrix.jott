#full Phase 4 matrix
Def noparam[]:Integer{
    Return 42;
}
Def onep[a:Integer]:Integer{
    Return a;
}
Def fourp[a:Integer, b:Double, c:String, d:Boolean]:String{
    If[d]{
        Return c;
    }
    Return "no";
}
Def voidfn[a:Integer]:Void{
    ::print[a];
}
Def boolfn[n:Integer]:Boolean{
    Return n > 10;
}
Def dblfn[x:Double]:Double{
    Return x * 2.0;
}
Def strfn[s:String]:String{
    Return ::concat[s, "X"];
}
Def countdown[n:Integer]:Integer{
    Integer i;
    i = n;
    While[i > 0]{
        i = i - 1;
    }
    Return i;
}
Def deep[n:Integer]:Integer{
    Integer r;
    r = 0;
    While[n > 0]{
        If[n > 3]{
            While[r > 100]{
                r = 0;
            }
            r = r + 2;
        }
        Elseif[n > 2]{
            If[r > 0]{
                r = r + 1;
            }
            Else{
                r = 1;
            }
        }
        Elseif[n > 1]{
            r = r + 10;
        }
        Else{
            r = r + 100;
        }
        n = n - 1;
    }
    Return r;
}
Def recurse[n:Integer]:Integer{
    If[n > 0]{
        Return ::recurse[n - 1];
    }
    Return 0;
}
